<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#121212">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Generate Key"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Validity (days)"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etDays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="e.g. 30"
        android:inputType="number"
        android:textColor="#FFFFFF"
        android:textColorHint="#555555"
        android:background="#1E1E1E"
        android:padding="12dp"
        android:layout_marginBottom="24dp"/>

    <ProgressBar
        android:id="@+id/progressGenerate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnGenerateKey"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Generate Key"
        android:textSize="16sp"
        android:layout_marginBottom="24dp"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#1E1E1E">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Generated Key:"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvGeneratedKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#44FF88"
                android:textSize="14sp"
                android:fontFamily="monospace"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnCopyKey"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Copy Key"
        android:visibility="gone"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnShareKey"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Share Key"
        android:visibility="gone"/>

</LinearLayout>
