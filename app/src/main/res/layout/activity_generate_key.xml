<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Generate Key"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FF4444"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Validity (Days)"
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etDays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. 30"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:background="@drawable/input_bg"
            android:padding="14dp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Features"
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:layout_marginBottom="12dp"/>

        <CheckBox
            android:id="@+id/cbEsp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ESP"
            android:textColor="#FFFFFF"
            android:buttonTint="#FF4444"
            android:layout_marginBottom="8dp"/>

        <CheckBox
            android:id="@+id/cbAimbot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aimbot"
            android:textColor="#FFFFFF"
            android:buttonTint="#FF4444"
            android:layout_marginBottom="8dp"/>

        <CheckBox
            android:id="@+id/cbSpeedhack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Speedhack"
            android:textColor="#FFFFFF"
            android:buttonTint="#FF4444"
            android:layout_marginBottom="32dp"/>

        <ProgressBar
            android:id="@+id/progressGenerate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnGenerateKey"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="GENERATE KEY"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF4444"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <LinearLayout
            android:id="@+id/cardResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/input_bg"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Generated Key:"
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvGeneratedKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#44FF88"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCopyKey"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Copy Key"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#333333"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btnShareKey"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Copy Share Msg"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#333333"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
            android:text="Generated Key:"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvGeneratedKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#44FF88"
                android:textSize="14sp"
                android:fontFamily="monospace"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnCopyKey"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Copy Key"
        android:visibility="gone"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnShareKey"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Share Key"
        android:visibility="gone"/>

</LinearLayout>
